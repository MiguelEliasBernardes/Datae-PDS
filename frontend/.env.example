# Copie este arquivo para .env.local (que não vai para o git) e preencha.

# Client ID do OAuth do Google (Google Cloud Console → APIs e serviços → Credenciais).
# Precisa ser o MESMO configurado no backend em Google:ClientId.
VITE_GOOGLE_CLIENT_ID=

# Endereço do backend em produção (ex.: https://datae-api.onrender.com). Em desenvolvimento, deixe vazio:
# o Vite repassa /api para http://localhost:5009.
VITE_API_URL=
